# Tout est optionnel : sans identifiants, HubSpot et Slack sont simulés (voir data/outbox.jsonl).
SLACK_WEBHOOK_URL=
HUBSPOT_TOKEN=
# Laisser vide pour le vrai HubSpot. ./demo.sh le règle lui-même sur le simulateur local.
HUBSPOT_BASE_URL=
# Si renseigné, le webhook exige l'en-tête X-Webhook-Secret.
WEBHOOK_SECRET=
# 127.0.0.1 et non localhost, qui peut pointer vers un autre service sur le même port.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
